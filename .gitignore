# 依赖与构建产物不入库（注意：锚定到仓库根，避免误伤 plugin/*/dist 里手写的客户端 bundle）
/node_modules/
/dist/
/dist-web/
/dist-plugin/
/dist-typwriter/
# Typwriter 构建在 apps 下的变体目录（vite outDir）
/apps/texpile-editor/dist-plugin/
/apps/texpile-editor/dist-typwriter/
/build/
/.wrangler/
*.log
# 例外：LaTeX 编译日志的测试 fixtures（上游生成入库的对照样本，见 parser.test.ts 头注）
!apps/texpile-editor/tests/unit/lib/latex-log/fixtures/*.log

# 插件：只排除构建出来的应用包与第三方二进制（见 README「Toolchain」）
plugin/*/app/
plugin/*/bin/
plugin/*/node_modules/

# Texpile 的 i18n 编译缓存（可重新生成）
apps/texpile-editor/project.inlang/cache/

# 系统垃圾
.DS_Store
Thumbs.db
